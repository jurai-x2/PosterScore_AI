PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Add your Gemini key only to the local .env file; never commit a live credential.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional comma-separated fallbacks. Use only model IDs enabled for your Gemini project.
GEMINI_FALLBACK_MODELS=
# Bounded per-model retry settings.
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_INITIAL_DELAY_MS=800
GEMINI_RETRY_MAX_DELAY_MS=4000
# One end-to-end server budget and one per-provider-call budget.
ANALYZE_TOTAL_BUDGET_MS=100000
PROVIDER_CALL_TIMEOUT_MS=60000
GEMINI_THINKING_LEVEL=low
DEMO_MODE=false
VITE_USE_MOCK_ANALYSIS=false
